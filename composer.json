{
    "name": "overherz/elastic5_6_16_php8",
    "description": "Elastica 6.2.1 fork for Elasticsearch 5.6 on PHP 7.1-8.5",
    "keywords": ["search","client"],
    "homepage": "https://github.com/overherz/elastic5_6_16_php8",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Ruflin",
            "homepage": "http://ruflin.com/"
        }
    ],
    "require": {
        "php": "^7.1||^8.0",
        "ext-json": "*",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "elasticsearch/elasticsearch": "^6.0"
    },
    "require-dev": {
        "aws/aws-sdk-php": "~3.0",
        "guzzlehttp/guzzle": "^6.0||^7.0",
        "phpunit/phpunit": "^6.0||^8.5.20",
        "yoast/phpunit-polyfills": "1.0.1"
    },
    "replace": {
        "ruflin/elastica": "6.2.1"
    },
    "conflict": {
        "elasticsearch/elasticsearch": "6.8.0 || 6.8.1",
        "guzzlehttp/psr7": "<1.7"
    },
    "suggest": {
        "aws/aws-sdk-php": "Allow using IAM authentication with Amazon ElasticSearch Service",
        "egeloen/http-adapter": "Allow using httpadapter transport",
        "guzzlehttp/guzzle": "Allow using guzzle 6 or 7 as the http transport",
        "monolog/monolog": "Logging request"
    },
    "autoload": {
        "psr-4": {
            "Elastica\\": "lib/Elastica/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elastica\\Test\\": "test/Elastica/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
